programa
{
	funcao inicio()
	{
		// Declara a variável para armazenar o nome
		cadeia nome

		// Exibe uma mensagem na tela para o usuário
		escreva("Digite o seu nome: ")

		// Lê o que foi digitado e guarda na variável
		leia(nome)

		// Mensagem de confirmação usando o nome digitado
		escreva("Olá, ", nome, "! Seja bem-vindo.")
	}
}
