// leia a largura e altura do retangulo e calcular a area
programa {
  funcao inicio() {
    inteiro area, altura, largura
    escreva ("Digite o valor da altura: ")
    leia (altura)
    escreva ("Digite o valor da largura: ")
    leia (largura)
    area = altura * largura
    escreva ("A área do retângulo é: " + area)
    
  }
}
