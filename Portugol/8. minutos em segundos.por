// ler uma quantidade de minutos e determinar quanto vale em segundos
programa {
  funcao inicio() {
    inteiro minutos, segundos
    escreva ("Digite o tempo em minutos: ")
    leia (minutos)
    segundos = minutos * 60
    escreva (minutos, " minutos em segundos são " + segundos, " segundos.")
    
  }
}
